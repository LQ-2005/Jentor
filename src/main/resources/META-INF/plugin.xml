<idea-plugin>
    <id>com.tongji.cst3492.jentor</id>
    <name>Jentor</name>
    <version>2.1.0</version>
    <vendor>Tongji University</vendor>

    <description>
        Jentor is a course-specific teaching assistant for CST3492 Java Enterprise
        Application Development. Enterprise Java, made clear. It retrieves relevant
        lecture slides, answers questions with document and page citations, and can
        independently manage PDF, Office, text, web and image course materials from
        any folder, use structured tables and offline English/Chinese OCR, and attach
        selected editor code or workspace source files to the conversation.
        AI-suggested source edits can span multiple files or create new source
        files, are reviewed in IntelliJ's built-in diff and applied only after
        approval. Chats are saved locally per project with new-chat, search,
        rename and delete controls.
    </description>

    <idea-version since-build="252" until-build="262.*"/>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                id="Jentor"
                anchor="right"
                factoryClass="com.tongji.cst3492.jentor.ui.CourseTaToolWindowFactory"/>
        <applicationService
                serviceImplementation="com.tongji.cst3492.jentor.settings.TaSettings"/>
        <applicationConfigurable
                id="com.tongji.cst3492.jentor.settings"
                parentId="tools"
                displayName="Jentor"
                instance="com.tongji.cst3492.jentor.settings.TaConfigurable"/>
        <postStartupActivity
                implementation="com.tongji.cst3492.jentor.service.WorkspaceIndexStartup"/>
        <postStartupActivity
                implementation="com.tongji.cst3492.jentor.service.CourseLibraryStartup"/>
    </extensions>

    <actions>
        <action
                id="Jentor.AskSelection"
                class="com.tongji.cst3492.jentor.action.AskSelectionAction"
                text="Ask Jentor about Selection"
                description="Attach the selected code to the Jentor chat">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
        <action
                id="Jentor.EditCode"
                class="com.tongji.cst3492.jentor.action.EditCodeAction"
                text="Edit Code with Jentor"
                description="Preview an AI code change in IntelliJ's diff viewer">
            <add-to-group group-id="EditorPopupMenu" anchor="after"
                          relative-to-action="Jentor.AskSelection"/>
        </action>
        <action
                id="Jentor.AttachFile"
                class="com.tongji.cst3492.jentor.action.AttachFileAction"
                text="Attach File to Jentor"
                description="Attach workspace source files to the Jentor chat">
            <add-to-group group-id="EditorPopupMenu" anchor="after"
                          relative-to-action="Jentor.AskSelection"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
